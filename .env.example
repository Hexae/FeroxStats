# ─────────────────────────────────────────────────────────────────────────────
# FeroxStats — Environment Variables
#
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API

# Public (exposed to the browser — safe to share)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Secret (server-side only — never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Ferox.ps API ──────────────────────────────────────────────────────────────
# Optional — overrides the default Ferox API base URL.
# Defaults to: https://ferox.ps/api
# NEXT_PUBLIC_FEROX_API_BASE=https://ferox.ps/api

# ── Resend ────────────────────────────────────────────────────────────────────
# Used as the SMTP password in Supabase Auth → SMTP Settings.
# SMTP host: smtp.resend.com  |  port: 465  |  user: resend
# Create an API key at: https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key

# ── Cron job secret ───────────────────────────────────────────────────────────
# Used to authenticate requests to /api/cron/update-players.
# Set this to a long, random string and pass it as: Authorization: Bearer <secret>
# Generate one with: openssl rand -base64 32
CRON_SECRET=your-cron-secret
